{
  "name": "arduinoq",
  "title": "Arduino Q",
  "description": "Arduino Q boards combine a Linux application processor with a microcontroller running Arduino sketches on Zephyr OS, bringing together Linux computing and real-time control.",
  "homepage": "https://www.arduino.cc/product-uno-q",
  "keywords": [
    "dev-platform",
    "arduino",
    "arduino-q",
    "zephyr",
    "arm",
    "cortex-m33",
    "stm32"
  ],
  "engines": {
    "platformio": "^6.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lee-lab-skku/platform-arduinoq.git"
  },
  "version": "1.0.0-rc.4",
  "frameworks": {
    "arduino": {
      "package": "framework-arduino-zephyr",
      "script": "builder/frameworks/arduino-zephyr.py",
      "title": "Arduino Core for Zephyr (Arduino fork)"
    }
  },
  "authors": [
    {
      "name": "Taeha Shin",
      "email": "mirinae3145@skku.edu",
      "maintainer": true
    }
  ],
  "license": "Apache-2.0",
  "packages": {
    "toolchain-gccarmzephyreabi": {
      "type": "toolchain",
      "version": "0.16.8-leelabskku"
    },
    "framework-arduino-zephyr": {
      "type": "framework",
      "version": "0.56.0-leelabskku+unoq"
    },
    "tool-zephyrsketch": {
      "type": "tool",
      "version": "0.4.0-leelabskku"
    },
    "tool-genrodatald": {
      "type": "tool",
      "version": "0.1.1-leelabskku"
    },
    "tool-zephyrchecksize": {
      "type": "tool",
      "version": "0.1.0-leelabskku"
    }
  }
}
